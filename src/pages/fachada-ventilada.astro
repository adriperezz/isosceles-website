---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import CallToAction from '../components/Global/CallToAction.astro';
---

<Layout
  title="Fachada Ventilada - Isósceles Global Constructora"
  description="Instalación de fachadas ventiladas en Vigo y alrededores para mejorar la eficiencia energética, el aislamiento y la estética de los edificios. Descubre cómo en Isósceles Global podemos transformar tu fachada."
  url="https://www.isoscelesglobal.com/fachada-ventilada/"
  image="/images/fachada-ventilada.webp"
>
  <body class="bg-white text-gray-800">
    <!-- Header -->
    <header class="bg-blue-950 text-white py-8">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl font-bold">Fachada ventilada</h1>
        <p class="mt-2 text-lg">
          Mejora el rendimiento térmico y estético de tu edificio con un sistema
          de fachada ventilada moderno y eficiente.
        </p>
      </div>
    </header>

    <!-- Introducción a la Fachada Ventilada -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center gap-12">
          <div class="md:w-1/2 2xl:w-2/3">
            <h2
              class="text-2xl md:text-4xl lg:text-5xl font-bold mb-4 text-gray-800"
            >
              ¿Qué es una <span class="text-blue-900">fachada ventilada</span>?
            </h2>
            <p class="text-lg md:text-xl text-gray-700 mb-6">
              Es un sistema constructivo que consiste en la colocación de un
              revestimiento exterior separado del muro mediante una estructura
              portante, creando una cámara de aire que mejora el aislamiento
              térmico, acústico y protege el edificio de la humedad.
            </p>
          </div>
          <div class="md:w-1/2 2xl:w-1/3">
            <img
              src="/images/fachada-ventilada.webp"
              alt="Fachada ventilada instalada por Isósceles Global en Vigo"
              class="rounded-lg shadow-lg w-full h-auto min-w-52"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios de la Fachada Ventilada -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2
          class="text-2xl md:text-4xl lg:text-5xl font-bold text-center mb-8 text-gray-800"
        >
          <span class="text-blue-900">Beneficios</span> de la fachada ventilada
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div
            class="text-center p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 border-2 border-stone-100"
          >
            <Icon
              name="mdi:weather-windy"
              class="text-blue-900 text-6xl mx-auto mb-4"
            />
            <h3 class="text-2xl font-semibold text-blue-900 mb-4">
              Aislamiento térmico y acústico
            </h3>
            <p class="text-gray-600 text-lg">
              Gracias a la cámara de aire, mejora el confort térmico y reduce el
              ruido exterior, aumentando la eficiencia energética.
            </p>
          </div>

          <div
            class="text-center p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 border-2 border-stone-100"
          >
            <Icon
              name="mdi:home-modern"
              class="text-blue-900 text-6xl mx-auto mb-4"
            />
            <h3 class="text-2xl font-semibold text-blue-900 mb-4">
              Estética moderna
            </h3>
            <p class="text-gray-600 text-lg">
              Amplia variedad de acabados y materiales que mejoran la apariencia
              del edificio, dándole un aspecto contemporáneo.
            </p>
          </div>

          <div
            class="text-center p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 border-2 border-stone-100"
          >
            <Icon
              name="mdi:shield-check"
              class="text-blue-900 text-6xl mx-auto mb-4"
            />
            <h3 class="text-2xl font-semibold text-blue-900 mb-4">
              Protección y durabilidad
            </h3>
            <p class="text-gray-600 text-lg">
              Protege la estructura del edificio frente a la lluvia, el sol y
              otros agentes externos, prolongando su vida útil.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Proceso de instalación de la Fachada Ventilada -->
    <section class="py-16 bg-gray-100">
      <div class="container mx-auto px-4">
        <h2
          class="text-2xl md:text-4xl lg:text-5xl font-bold text-center mb-8 text-gray-800"
        >
          Proceso de <span class="text-blue-900">instalación</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">
          <div
            class="bg-white p-6 rounded-lg shadow-lg border-2 border-stone-100"
          >
            <div class="flex items-center mb-4">
              <span
                class="bg-blue-900 text-white rounded-full h-12 w-12 flex items-center justify-center text-xl font-bold"
                >1</span
              >
              <h3 class="text-xl font-semibold text-blue-900 ml-4">
                Estudio técnico
              </h3>
            </div>
            <p class="text-gray-600 text-lg">
              Analizamos las características del edificio y elegimos los
              materiales y soluciones óptimas según sus necesidades.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-lg border-2 border-stone-100"
          >
            <div class="flex items-center mb-4">
              <span
                class="bg-blue-900 text-white rounded-full h-12 w-12 flex items-center justify-center text-xl font-bold"
                >2</span
              >
              <h3 class="text-xl font-semibold text-blue-900 ml-4">
                Instalación de subestructura
              </h3>
            </div>
            <p class="text-gray-600 text-lg">
              Fijamos una estructura metálica resistente sobre la que se
              instalará la cámara de aire y el revestimiento final.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-lg border-2 border-stone-100"
          >
            <div class="flex items-center mb-4">
              <span
                class="bg-blue-900 text-white rounded-full h-12 w-12 flex items-center justify-center text-xl font-bold"
                >3</span
              >
              <h3 class="text-xl font-semibold text-blue-900 ml-4">
                Colocación del aislamiento
              </h3>
            </div>
            <p class="text-gray-600 text-lg">
              Instalamos paneles aislantes entre la fachada y el revestimiento
              exterior para maximizar la eficiencia energética.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-lg border-2 border-stone-100"
          >
            <div class="flex items-center mb-4">
              <span
                class="bg-blue-900 text-white rounded-full h-12 w-12 flex items-center justify-center text-xl font-bold"
                >4</span
              >
              <h3 class="text-xl font-semibold text-blue-900 ml-4">
                Revestimiento exterior
              </h3>
            </div>
            <p class="text-gray-600 text-lg">
              Finalizamos con placas decorativas resistentes, creando una
              fachada moderna, protegida y ventilada.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Errores comunes y soluciones -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2
          class="text-2xl md:text-4xl lg:text-5xl font-bold text-center mb-8 text-gray-800"
        >
          Evita estos <span class="text-blue-900">errores comunes</span> en fachadas
          ventiladas
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8">
          <div
            class="bg-white p-6 rounded-lg shadow-md border-l-4 border-red-600"
          >
            <div class="flex items-center gap-3">
              <Icon name="mdi:hammer-wrench" class="text-red-600 text-4xl" />
              <h3 class="text-xl font-semibold text-red-600">
                Fijaciones inadecuadas
              </h3>
            </div>
            <p class="text-gray-700 mt-3">
              Utilizar sistemas de anclaje incorrectos compromete la seguridad y
              estabilidad del revestimiento.
            </p>
            <p class="text-blue-900 font-semibold mt-2">
              ✔ Solución: Usar fijaciones certificadas y adecuadas a la
              estructura.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-md border-l-4 border-red-600"
          >
            <div class="flex items-center gap-3">
              <Icon name="mdi:air-filter" class="text-red-600 text-4xl" />
              <h3 class="text-xl font-semibold text-red-600">
                Obstrucción de la cámara de aire
              </h3>
            </div>
            <p class="text-gray-700 mt-3">
              No dejar la ventilación adecuada impide que el sistema funcione
              correctamente, acumulando humedad.
            </p>
            <p class="text-blue-900 font-semibold mt-2">
              ✔ Solución: Garantizar una cámara continua y bien ventilada.
            </p>
          </div>

          <div
            class="bg-white p-6 rounded-lg shadow-md border-l-4 border-red-600"
          >
            <div class="flex items-center gap-3">
              <Icon name="mdi:alert-circle" class="text-red-600 text-4xl" />
              <h3 class="text-xl font-semibold text-red-600">
                Mal sellado de encuentros
              </h3>
            </div>
            <p class="text-gray-700 mt-3">
              Las uniones mal ejecutadas generan filtraciones y pérdida de
              eficiencia.
            </p>
            <p class="text-blue-900 font-semibold mt-2">
              ✔ Solución: Sellado preciso y supervisión técnica en puntos
              críticos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <CallToAction />
  </body>
</Layout>
